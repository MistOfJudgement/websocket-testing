{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-signaler",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",

  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_ROOM",
        "class_name": "SignalingRoom"
      },
      {
        "name": "CHAT_LOBBY_ROOM",
        "class_name": "ChatLobbyRoom"
      }
    ]
  },
  "exports": {
		"SignalingRoom": {
			"type": "durable-object",
			"storage": "sqlite",
		},
    "ChatLobbyRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
	},
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
}